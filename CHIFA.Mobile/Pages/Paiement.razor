@page "/paiement"
@inject Session Session
@inject IJSRuntime Js

@* Same prices and accounts as the website (website/index.html, #tarifs and #paiement): change both together. *@

<div class="page-head"><h1>Tarifs et paiement</h1></div>
<p class="muted small">Toutes les fonctionnalités et l'application mobile dans chaque formule. Une licence par poste.</p>

<section class="plans-mini">
    <div class="card plan-mini">
        <span class="label">Annuel</span>
        <strong class="ltr">12 000 <small>DA / an</small></strong>
        <span class="muted small">Support prioritaire et mises à jour</span>
    </div>
    <div class="card plan-mini">
        <span class="label">Licence à vie</span>
        <strong class="ltr">50 000 <small>DA</small></strong>
        <span class="muted small">Support inclus la 1ʳᵉ année</span>
    </div>
</section>
<p class="muted small">Plusieurs postes ou plusieurs officines ? Contactez-nous pour un tarif adapté.</p>

<section class="card">
    <h2>Comptes CCP et bancaire</h2>
    <div class="copy-row"><div><small>Titulaire</small><b>@Holder</b></div></div>
    @foreach (var (label, value) in Accounts)
    {
        <div class="copy-row">
            <div><small>@label</small><b class="ltr">@value</b></div>
            <button class="button small secondary" type="button" @onclick="() => CopyAsync(value)">@(_copied == value ? "Copié" : "Copier")</button>
        </div>
    }
</section>

<section class="card">
    <h2>Comment payer</h2>
    <ol class="pay-steps">
        <li><strong>Demandez votre licence</strong><span>Dans <a href="abonnement">Abonnement et appareils</a> sur ce téléphone, ou dans SmartCHIFA (menu « Licence »).</span></li>
        <li><strong>Payez le montant de votre formule</strong><span>Versement au bureau de poste sur le N° CCP, virement BaridiMob vers le RIP, ou virement bancaire vers le RIB BADR.</span></li>
        <li><strong>Envoyez le reçu sur WhatsApp</strong><span>Une photo du reçu avec le nom de votre pharmacie suffit : nous activons la licence et vous prévenons.</span></li>
    </ol>
    <div class="guest-message">
        <p lang="ar" dir="rtl">ادفع عبر <bdi>CCP</bdi> أو <bdi>BaridiMob</bdi> أو تحويل بنكي، ثم أرسل صورة الوصل مع اسم الصيدلية على واتساب، ويُفعَّل الترخيص فور استلامه.</p>
    </div>
    <a class="button wide whatsapp-button" href="@ReceiptUrl" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.3zM9 8.5c0 3.5 3 6.5 6.5 6.5l1.2-1.6-2-1-1 1a5 5 0 0 1-3-3l1-1-1-2z" /></svg>
        Envoyer le reçu sur WhatsApp
    </a>
    <a class="link-button" href="@($"tel:{Assistance.Phone.Replace(" ", "")}")">Une question ? Appelez le @Assistance.Phone</a>
</section>

@code {
    private const string Holder = "MEZHOUDI Hadj Nadir";

    private static readonly (string Label, string Value)[] Accounts =
    [
        ("N° CCP / Clé", "14692319 / 50"),
        ("RIP (virement BaridiMob)", "00799999 0014692319 49"),
        ("RIB BADR (virement bancaire)", "003 00656 0000131300 03")
    ];

    private string? _copied;

    // Like the website: banking apps want the RIP and RIB without spaces.
    private static string ToCopy(string value) => value.Contains('/') ? value : value.Replace(" ", "");

    private string ReceiptUrl =>
        $"https://wa.me/{Assistance.WhatsApp}?text={Uri.EscapeDataString($"Bonjour, voici le reçu de paiement SmartCHIFA{(Session.Current is { } s ? $" de {s.Pharmacy}" : "")}.")}";

    private async Task CopyAsync(string value)
    {
        if (await Js.InvokeAsync<bool>("chifa.copy", ToCopy(value)))
            _copied = value;
    }
}
