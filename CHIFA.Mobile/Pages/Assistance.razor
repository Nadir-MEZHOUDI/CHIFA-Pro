@page "/assistance"
@inject Session Session
@inject IJSRuntime Js

<div class="page-head"><h1>Assistance et contact</h1></div>
<p class="muted small">Installation, licence, paiement ou problème : l'équipe SmartApp vous répond.</p>

<section class="contacts">
    <a class="card link contact" href="@($"tel:{Phone.Replace(" ", "")}")">
        <svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
        <span><strong>Appeler</strong><span class="muted small">@Phone</span></span>
    </a>
    <a class="card link contact whatsapp" href="@WhatsAppUrl" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.3zM9 8.5c0 3.5 3 6.5 6.5 6.5l1.2-1.6-2-1-1 1a5 5 0 0 1-3-3l1-1-1-2z" /></svg>
        <span><strong>Écrire sur WhatsApp</strong><span class="muted small">@Phone</span></span>
    </a>
    <a class="card link contact" href="paiement">
        <svg viewBox="0 0 24 24"><path d="M2 6h20v12H2zM2 10h20M6 15h4" /></svg>
        <span><strong>Tarifs et paiement</strong><span class="muted small">CCP, BaridiMob ou virement bancaire : les comptes à copier.</span></span>
    </a>
    <a class="card link contact" href="@($"{Website}/#assistance")" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M2 4h20v12H2zM8 20h8M12 16v4" /></svg>
        <span><strong>Assistance à distance</strong><span class="muted small">Sur le PC de la pharmacie, avec RustDesk : nous réglons le problème avec vous.</span></span>
    </a>
    <a class="card link contact" href="@Website" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" /></svg>
        <span><strong>Site SmartCHIFA</strong><span class="muted small">Tarifs, paiement, questions fréquentes.</span></span>
    </a>
</section>

<section class="card notify">
    <div class="notify-head">
        <svg viewBox="0 0 24 24"><path d="M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>
        <div>
            <strong>Recommander SmartCHIFA</strong>
            <span class="muted small">Envoyez le lien à un confrère pharmacien.</span>
        </div>
    </div>
    <button class="button wide" @onclick="ShareAsync">Partager l'application</button>
</section>

@code {
    public const string Website = "https://smartchifa.smartappdz.org";
    public const string Phone = "06 71 71 66 66";
    public const string WhatsApp = "213671716666";

    private string WhatsAppUrl =>
        $"https://wa.me/{WhatsApp}?text={Uri.EscapeDataString($"Bonjour{(Session.Current is { } s ? $", ici {s.Pharmacy}" : "")} (SmartCHIFA mobile). J'ai besoin d'aide avec SmartCHIFA.")}";

    private async Task ShareAsync() => await Share(Js);

    public static async Task Share(IJSRuntime js) =>
        await js.InvokeVoidAsync("chifa.share", "SmartCHIFA",
            "SmartCHIFA, le logiciel CHIFA pour officine : bordereaux, rejets, psychotropes, patients et statistiques, sur PC et téléphone.",
            Website);
}
