@using CHIFA.Contract
@* Round call / SMS buttons for a phone of the patient phone book. Nothing for an invalid number. *@
@if (ContactLinks.Call(Phone) is { } call)
{
    <span class="call-links">
        <a class="call-link" href="@call" title="Appeler @AlgerianPhone.Format(Phone)" aria-label="Appeler">
            <svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
        </a>
        @if (ContactLinks.Sms(SmsPhone ?? Phone, SmsBody) is { } sms)
        {
            <a class="call-link sms" href="@sms" title="SMS" aria-label="Envoyer un SMS">
                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
            </a>
        }
    </span>
}

@code {
    [Parameter, EditorRequired] public string? Phone { get; set; }

    /// <summary>The number to text when it is not <see cref="Phone"/> (a landline cannot receive an SMS).</summary>
    [Parameter] public string? SmsPhone { get; set; }

    [Parameter] public string? SmsBody { get; set; }
}
