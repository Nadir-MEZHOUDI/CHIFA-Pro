<div class="chips">
    @foreach (var period in Choices)
    {
        <button class="chip @(period.Label == Selected.Label ? "active" : "")" @onclick="() => SelectedChanged.InvokeAsync(period)">@period.Label</button>
    }
</div>

@code {
    public static readonly IReadOnlyList<Period> Choices = Period.Choices();

    [Parameter, EditorRequired] public Period Selected { get; set; } = default!;
    [Parameter] public EventCallback<Period> SelectedChanged { get; set; }

    public static Period Named(string label) => Choices.First(p => p.Label == label);
}
