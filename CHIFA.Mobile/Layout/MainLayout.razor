@inherits LayoutComponentBase
@implements IDisposable
@inject Session Session
@inject Api Api
@inject NavigationManager Nav
@inject IJSRuntime Js

<div class="shell @(_menuOpen ? "menu-open" : "")" @onkeydown="OnKeyDown">
        <aside class="drawer" id="menu" aria-label="Menu">
            <div class="drawer-brand">
                <img src="icon-192.png" alt="" />
                <div>
                    <strong>SmartCHIFA</strong>
                    <span>@(Session.Current?.Pharmacy ?? "Téléphone non lié")</span>
                </div>
            </div>
            <nav class="drawer-nav">
                @foreach (var item in NavItem.All)
                {
                    <NavLink href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <svg viewBox="0 0 24 24"><path d="@item.Icon" /></svg>@item.Label
                    </NavLink>
                }
            </nav>
            <div class="drawer-foot">
                @if (_install != "none")
                {
                    <button class="drawer-action" @onclick="InstallAsync">
                        <svg viewBox="0 0 24 24"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>Installer l'application
                    </button>
                }
                <button class="drawer-action" @onclick="() => Pages.Assistance.Share(Js)">
                    <svg viewBox="0 0 24 24"><path d="M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>Partager l'application
                </button>
                @if (Session.IsSignedIn)
                {
                    <button class="drawer-action" @onclick="SignOutAsync">
                        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>Se déconnecter
                    </button>
                }
                else
                {
                    <button class="drawer-action" @onclick="@(() => Nav.NavigateTo("login"))">
                        <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg>Lier ce téléphone
                    </button>
                }
            </div>
        </aside>
        <div class="drawer-backdrop" @onclick="CloseMenu"></div>

        <div class="main">
            <header class="topbar">
                <button class="icon-button menu-button" title="Menu" aria-controls="menu" aria-expanded="@(_menuOpen ? "true" : "false")" @onclick="ToggleMenu">
                    <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
                <img class="topbar-logo" src="icon-192.png" alt="" />
                <div class="topbar-title">
                    <span class="pharmacy">@(Session.Current?.Pharmacy ?? "SmartCHIFA")</span>
                    @if (!Session.IsSignedIn)
                    {
                        <span class="status offline"><span class="dot"></span>Téléphone non lié</span>
                    }
                    else if (_status is { SubscriptionEnded: true } ended)
                    {
                        <span class="status offline"><span class="dot"></span>@(ended.IsTrial ? "Essai gratuit terminé" : "Abonnement terminé")</span>
                    }
                    else if (_status is { } s)
                    {
                        <span class="status @(s.Online ? "online" : "offline")">
                            <span class="dot"></span>@(s.Online ? "Pharmacie en ligne" : $"Hors ligne · vue {Fmt.Ago(s.LastSeenAt)}")
                        </span>
                    }
                </div>
                @if (_install != "none")
                {
                    <button class="install-button" title="Installer l'application" @onclick="InstallAsync">
                        <svg viewBox="0 0 24 24"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>Installer
                    </button>
                }
            </header>

            <main class="content">
                @if (!Session.IsSignedIn)
                {
                    if (GuestPages.Contains(CurrentPage))
                    {
                        @Body
                    }
                    else
                    {
                        <GuestScreen PageTitle="@GuestPageTitle" CanInstall="@(_install != "none")" Install="InstallAsync" />
                    }
                }
                else if (SubscriptionBlocked)
                {
                    <SubscriptionEnded Status="_status!" />
                }
                else if (PharmacyDown)
                {
                    <PharmacyOffline Status="_status!" Retry="RefreshStatusAsync" />
                }
                else
                {
                    @Body
                }
            </main>
        </div>

        <nav class="tabbar">
            @foreach (var item in NavItem.All.Where(i => i.InTabBar))
            {
                <NavLink href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    <svg viewBox="0 0 24 24"><path d="@item.Icon" /></svg>@(item.Short ?? item.Label)
                </NavLink>
            }
        </nav>
    </div>

@code {
    private OfficineStatus? _status;
    private PeriodicTimer? _timer;
    private string _install = "none";
    private bool _menuOpen;
    private DotNetObjectReference<MainLayout>? _self;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        SyncStatusLoop();
    }

    // The login page shares this layout, so the phone can be linked or unlinked without the layout being rebuilt.
    private void SyncStatusLoop()
    {
        if (Session.IsSignedIn && _timer is null)
        {
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            _ = RefreshStatusLoopAsync(_timer);
        }
        else if (!Session.IsSignedIn && _timer is not null)
        {
            _timer.Dispose();
            _timer = null;
            _status = null;
        }
    }

    // The pharmacy can go offline at any time (PC off, no internet): refresh the badge every 30 s.
    private async Task RefreshStatusLoopAsync(PeriodicTimer timer)
    {
        do
        {
            await RefreshStatusAsync();
        } while (await timer.WaitForNextTickAsync());
    }

    private async Task RefreshStatusAsync()
    {
        try
        {
            _status = await Api.StatusAsync();
            StateHasChanged();
        }
        catch (ApiException)
        {
        }
    }

    // These pages don't need the pharmacy PC, so they keep working while it is off.
    private static readonly string[] GatewayPages = ["notifications", "abonnement", "assistance", "paiement", "login"];

    // An unlinked phone has no pharmacy behind it: these pages work as usual, the others ask to install SmartCHIFA.
    private static readonly string[] GuestPages = ["assistance", "paiement", "login"];

    private string CurrentPage => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#', '/')[0];

    private string? GuestPageTitle =>
        CurrentPage == "" ? null : NavItem.All.FirstOrDefault(i => i.Href == CurrentPage)?.Label ?? "SmartCHIFA";

    private bool PharmacyDown => _status is { Online: false } && !GatewayPages.Contains(CurrentPage);

    private bool SubscriptionBlocked => _status is { SubscriptionEnded: true } && !GatewayPages.Contains(CurrentPage);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _self = DotNetObjectReference.Create(this);
        _install = await Js.InvokeAsync<string>("chifa.install.watch", _self);
        StateHasChanged();
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _menuOpen = false;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        BackButton.HasInAppHistory = true;
        SyncStatusLoop();
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnInstallStateChanged(string state)
    {
        _install = state;
        return InvokeAsync(StateHasChanged);
    }

    private async Task InstallAsync() => await Js.InvokeVoidAsync("chifa.install.run");

    private async Task SignOutAsync()
    {
        var question = Session.DeviceToken is not null
            ? "Se déconnecter ? Pour revenir, il faudra un nouveau code affiché dans SmartCHIFA."
            : "Se déconnecter ?";
        if (!await Js.InvokeAsync<bool>("chifa.confirm", question))
            return;

        await Js.InvokeVoidAsync("chifa.push.forget");
        await Api.LogoutAsync();
        SyncStatusLoop();
        Nav.NavigateTo("");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _timer?.Dispose();
        if (_self is not null)
        {
            _ = Js.InvokeVoidAsync("chifa.install.unwatch").AsTask();
            _self.Dispose();
        }
    }
}
