<Window
    x:Class="CHIFA.Server.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CHIFA Mobile Server"
    MinWidth="500"
    MinHeight="400"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    FontFamily="Cascadia Code"
    FontSize="16"
    FontStyle="Italic"
    Icon="../Assets/icon.ico"
    SizeToContent="WidthAndHeight"
    mc:Ignorable="d">
    <Grid IsSharedSizeScope="True">
        <StackPanel Margin="10">
            <GroupBox Header="Settings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="A" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <CheckBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Checked="StartWithWin_OnChecked"
                        Content="Start with Windows"
                        IsChecked="{Binding AppSettings.StartWithWin}"
                        Unchecked="StartWithWin_OnUnchecked" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Email : " />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        Padding="3"
                        Text="{Binding AppSettings.ChifaMobilEmail, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Text="Password : " />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        Padding="3"
                        Text="{Binding AppSettings.ChifaMobilPassword, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="5"
                        Command="{Binding AppSettings.SaveCommand}"
                        Content="Save" />
                </Grid>
            </GroupBox>
            <GroupBox Header="Server">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="A" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Address : " />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Padding="3"
                        IsReadOnly="True"
                        Text="{Binding Server.Address, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Port : " />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        Padding="3"
                        IsReadOnly="True"
                        Text="{Binding Server.Port, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        Command="{Binding RunChifaMobileServerCommand}"
                        Content="Start" />

                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="5"
                        Command="{Binding StopServerCommand}"
                        Content="Stop" />
                </Grid>
            </GroupBox>
            <GroupBox Header="Test">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="A" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Address : " />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Padding="3"
                        TextAlignment="Center">
                        <Run Text="{Binding Client.Address}" />
                        <Run Text=" : " />
                        <Run Text="{Binding Client.Port}" />
                    </TextBlock>
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        Command="{Binding GetClientCommand}"
                        Content="Test" />
                </Grid>
            </GroupBox>

        </StackPanel>
    </Grid>
</Window>
