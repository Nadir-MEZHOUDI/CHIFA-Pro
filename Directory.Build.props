<Project>
	<PropertyGroup>
		<LangVersion>preview</LangVersion>
		<Authors>MEZHOUDI Hadj Nadir</Authors>
		<Company>SmartApps</Company>
		<Product>CHIFA Pro</Product>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>enable</Nullable>
		<SatelliteResourceLanguages>ar;fr;en</SatelliteResourceLanguages>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>
	<PropertyGroup>
		<CurrentDate>$([System.DateTime]::Now.ToString("yyyy.MM.dd"))</CurrentDate>

		<!-- Get the current date -->
		<CurrentYear>$([System.DateTime]::Now.Year)</CurrentYear>
		<CurrentMonth>$([System.DateTime]::Now.Month)</CurrentMonth>
		<CurrentDay>$([System.DateTime]::Now.Day)</CurrentDay>


		<MajorVersion>$([MSBuild]::Subtract($(CurrentYear), 2022))</MajorVersion>
		<MinorVersion>$(CurrentMonth)</MinorVersion>
		<CurrentHour>$([System.DateTime]::Now.Hour)</CurrentHour>

		<!-- ddHH as a number: a leading zero on days 1-9 is an invalid semver patch and breaks Velopack Setup -->
		<PatchVersion>$([MSBuild]::Add($([MSBuild]::Multiply($(CurrentDay), 100)), $(CurrentHour)))</PatchVersion>

		<Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version>

		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
		<PackageVersion>$(Version)</PackageVersion>
	</PropertyGroup>
</Project>