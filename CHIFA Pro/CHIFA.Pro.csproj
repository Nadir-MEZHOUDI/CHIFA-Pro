<Project Sdk="Microsoft.NET.Sdk">
 	<PropertyGroup>
 		<TargetFramework>net10.0-windows</TargetFramework>
 		<OutputType>WinExe</OutputType>
 		<UseWindowsForms>true</UseWindowsForms>
 		<RootNamespace>CHIFA.Pro</RootNamespace>
   		<StartupObject>CHIFA.Pro.Program</StartupObject>
  		<Product>CHIFA.Pro</Product>
  		<ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
  		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningsAsErrors>DX1000;DX1001</WarningsAsErrors>
		<ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="FodyWeavers.xml" />
		<None Remove="FodyWeavers.xsd" />
		<None Remove="Icon.ico" />
	</ItemGroup>
	 
	<ItemGroup>
		<Content Include="Assets\Icon.ico" />
		<Content Include="Icon.ico">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	 
	<ItemGroup>
	  <PackageReference Include="DevExpress.Win.Design" Version="26.1.3" />
	  <PackageReference Include="Npgsql" Version="10.*" />
	  <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
	  <PackageReference Include="Serilog.Sinks.File" Version="7.*" />
	  <PackageReference Include="Velopack" Version="1.2.0" />
 	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CHIFA.DAL\CHIFA.DAL.csproj" />
 	</ItemGroup>

</Project>