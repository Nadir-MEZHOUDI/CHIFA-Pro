<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>CHIFA.Pro</RootNamespace>
  		<StartupObject>CHIFA.Pro.Program</StartupObject>
		<LangVersion>preview</LangVersion>
		<Authors>MEZHOUDI Hadj Nadir</Authors>
		<Company>SmartApps</Company>
		<Product>CHIFA Pro</Product>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.1.1</Version>
		<SatelliteResourceLanguages>ar;fr;en</SatelliteResourceLanguages>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="FodyWeavers.xml" />
		<None Remove="FodyWeavers.xsd" />
		<None Remove="Icon.ico" />
	</ItemGroup>
	 
	<ItemGroup>
		<Content Include="Assets\Icon.ico" />
		<Content Include="Icon.ico">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	 
	<ItemGroup>
	  <PackageReference Include="DevExpress.Win.Design" Version="24.1.*" />
	  <PackageReference Include="Velopack" Version="0.*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CHIFA.DAL\CHIFA.DAL.csproj" />
 	</ItemGroup>

</Project>